                "cmd": "whoami "
              },
              {
                "id": "item-kzzgqv73a",
                "type": "cmd",
                "title": "Show current date and time",
                "cmd": "date"
              },
              {
                "id": "item-pxj1k2423",
                "type": "cmd",
                "title": "Display operating system information",
                "cmd": "uname -a"
              }
            ]
          },
          {
            "id": "g2",
            "title": "Diagnose the Crash",
            "collapsed": false,
            "items": [
              {
                "id": "s3",
                "type": "cmd",
                "title": "Tail Order-Service Logs",
                "cmd": "kubectl logs deployment/order-service -f --tail=40"
              },
              {
                "id": "s4",
                "type": "cmd",
                "title": "Check Recent Cluster Events",
                "cmd": "kubectl get events -n production \\\n  --sort-by=.metadata.creationTimestamp"
              },
              {
                "id": "s5",
                "type": "cmd",
                "title": "Describe the Failing Pod",
                "cmd": "kubectl describe pod order-service-7f9d5b6c4-qm8zt \\\n  -n production"
              }
            ]
          },
          {
            "id": "g3",
            "title": "Remediate",
            "collapsed": false,
            "items": [
              {
                "id": "s6",
                "type": "cmd",
                "title": "Restart Deployment",
                "cmd": "kubectl rollout restart deployment/order-service \\\n  -n production"
              }
            ]
          }
        ],
